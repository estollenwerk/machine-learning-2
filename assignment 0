import numpy as np
import torch
import torch.nn as nn
import torch.optim as optim

dataset = np.loadtxt('CSC 2400 HW 4 Pima Indians Diabetes.csv', delimiter=',', encoding='utf-8-sig')
X = dataset[:,0:8]
y = dataset[:,8]

X = torch.tensor(X, dtype=torch.float32)
y = torch.tensor(y, dtype=torch.float32).reshape(-1, 1)

batch_size = 10

def train_and_eval(model, lr, n_epochs, label):
    print(f"\nRunning: {label}")
    loss_fn = nn.BCELoss()
    optimizer = optim.Adam(model.parameters(), lr=lr)
    for epoch in range(n_epochs):
        for i in range(0, len(X), batch_size):
            Xbatch = X[i:i+batch_size]
            ybatch = y[i:i+batch_size]
            y_pred = model(Xbatch)
            loss = loss_fn(y_pred, ybatch)
            optimizer.zero_grad()
            loss.backward()
            optimizer.step()
    with torch.no_grad():
        y_pred = model(X)
        accuracy = (y_pred.round() == y).float().mean().item()
    print(f"Final Accuracy ({label}): {accuracy:.4f}")
    return accuracy

default_model = nn.Sequential(
    nn.Linear(8, 12),
    nn.ReLU(),
    nn.Linear(12, 8),
    nn.ReLU(),
    nn.Linear(8, 1),
    nn.Sigmoid()
)
train_and_eval(default_model, lr=0.001, n_epochs=100, label="Default Network")

lr_model = nn.Sequential(
    nn.Linear(8, 12),
    nn.ReLU(),
    nn.Linear(12, 8),
    nn.ReLU(),
    nn.Linear(8, 1),
    nn.Sigmoid()
)
train_and_eval(lr_model, lr=0.1, n_epochs=100, label="LR = 0.1")

epoch_model = nn.Sequential(
    nn.Linear(8, 12),
    nn.ReLU(),
    nn.Linear(12, 8),
    nn.ReLU(),
    nn.Linear(8, 1),
    nn.Sigmoid()
)
train_and_eval(epoch_model, lr=0.001, n_epochs=200, label="Epochs = 200")

extra_layer_model = nn.Sequential(
    nn.Linear(8, 12),
    nn.ReLU(),
    nn.Linear(12, 12),
    nn.ReLU(),
    nn.Linear(12, 8),
    nn.ReLU(),
    nn.Linear(8, 1),
    nn.Sigmoid()
)
train_and_eval(extra_layer_model, lr=0.001, n_epochs=100, label="Extra Hidden Layer (12 nodes)")

big_model = nn.Sequential(
    nn.Linear(8, 100),
    nn.ReLU(),
    nn.Linear(100, 100),
    nn.ReLU(),
    nn.Linear(100, 100),
    nn.ReLU(),
    nn.Linear(100, 1),
    nn.Sigmoid()
)
train_and_eval(big_model, lr=0.001, n_epochs=100, label="All Hidden Layers = 100 Neurons")
